from mil.army.usace.hec.vortex.io import BatchImporter
from mil.army.usace.hec.vortex.geo import WktFactory
import glob
import os

# cd C:\Program Files\HEC\HEC-HMS\4.12
# HEC-HMS.cmd -script "C:\py\Atlas14_temporal_distribution\nc_to_dss.jy"

# proj = "Lawton"
proj = "I57_"

variables = ['PrecipInc']

# clip_shp = r"V:\projects\p00659_dec_glo_phase3\01_processing\GIS\Precip_Extents.shp"
# clip_shp = r"C:\Users\MBMcManus\OneDrive - Garver\Documents\Work\ArkansasRiverWest\GIS\boundingbox.shp"

geo_options = {
    # 'pathToShp': clip_shp,
    'targetCellSize': '1000',
    # 'targetWkt': WktFactory.shg(),
    # 'targetWkt': 'PROJCS["NAD83_2011_Oklahoma_South_ftUS",GEOGCS["GCS_NAD83_2011",DATUM["D_NAD83_NATIONAL_SPATIAL_REFERENCE_SYSTEM_2011",SPHEROID["GRS_1980",6378137,298.257222101]],PRIMEM["Greenwich",0],UNIT["Degree",0.017453292519943295]],PROJECTION["Lambert_Conformal_Conic"],PARAMETER["standard_parallel_1",33.93333333333333],PARAMETER["standard_parallel_2",35.23333333333333],PARAMETER["central_meridian",-98],PARAMETER["latitude_of_origin",33.33333333333334],PARAMETER["false_easting",1968500],PARAMETER["false_northing",0],UNIT["Foot_US",0.3048006096012192]]',
    # 'targetEpsg': '6557',  # NAD83(2011) / Oklahoma South (ftUS)
    'targetEpsg': '3433', # I57 projection
    'resamplingMethod': 'Bilinear'
}

# in_dir = r"Z:\py\Atlas14_temporal_distribution\output\Texas\nc"
in_dir = r"C:\py\Atlas14_temporal_distribution\output\%s\nc" % proj
f = glob.glob(in_dir+"//*.nc")
print ('*.nc Files found:' + str(len(f)))


out_dir = r"C:\py\Atlas14_temporal_distribution\output\%s\dss" % proj
if not os.path.exists(out_dir):
    os.makedirs(out_dir)

for afile in f:
    head, tail = os.path.split(afile)
    in_files = [afile]
    
    partA_list = tail.split("_")[1:5]
    partA = ' '.join(partA_list)
    
    partB_list = tail.split(".")[0].split("_")[5:-1]
    partB = ' '.join(partB_list)

    partF = tail.split("_")[0]
    
    write_options = {
    'partA': partA,
    'partB': partB,
    'partF': partF,
    'dataType': 'PER-CUM',
    }

    # print write_options

    destination = out_dir + '//' + tail.split(".")[0]+".dss"  
    # destination = out_dir + '//Atlas14.dss'

    myImport = BatchImporter.builder() \
        .inFiles(in_files) \
        .variables(variables) \
        .geoOptions(geo_options) \
        .destination(destination) \
        .writeOptions(write_options) \
        .build()
    
    # myImport = BatchImporter.builder() \
    #     .inFiles(in_files) \
    #     .variables(variables) \
    #     .destination(destination) \
    #     .writeOptions(write_options) \
    #     .build()

    myImport.process()

